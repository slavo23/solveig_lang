{
  "comments": {
    "lineComment": "--",
    "blockComment": [
      "{-",
      "-}"
    ]
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ],
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "autoCloseBefore": ";:.,=)}] \\n\\t",
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*--\\s*#?region\\b",
      "end": "^\\s*--\\s*#?endregion\\b"
    }
  },
  "wordPattern": "(?:\\?[A-Za-z_][A-Za-z0-9_']*|\\?\\?|[A-Za-z_][A-Za-z0-9_']*(?:\\.[A-Za-z_][A-Za-z0-9_']*)*|[!#$%&*+./<=>?@\\\\^|\\-~:]+|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)",
  "indentationRules": {
    "decreaseIndentPattern": "^\\s*(?:\\}|\\||in\\b|else\\b)",
    "indentNextLinePattern": "^\\s*(?:.*\\bcase\\b.*\\bof\\s*$|.*\\bdo\\s*$|.*\\bthen\\s*$|.*\\belse\\s*$|.*\\bwhere\\s*$|.*(?:=|=>)\\s*$)"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*.*\\bcase\\b.*\\bof\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*.*\\bdo\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*\\|.*=>\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*.*(?:=|=>)\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*.*\\b(?:then|else|where)\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^.*\\{[^}]*$",
      "afterText": "^\\s*\\}",
      "action": {
        "indent": "indentOutdent"
      }
    }
  ]
}
