{
  "comments": {
    "lineComment": "--",
    "blockComment": [
      "{-",
      "-}"
    ]
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "autoClosingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "autoCloseBefore": ";:.,=]) \n\t",
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*--\\s*#?region\\b",
      "end": "^\\s*--\\s*#?endregion\\b"
    }
  },
  "wordPattern": "(?:\\?[A-Za-z_][A-Za-z0-9_']*|\\?\\?|[A-Za-z_][A-Za-z0-9_']*(?:\\.[A-Za-z_][A-Za-z0-9_']*)*|\\d+)",
  "indentationRules": {
    "decreaseIndentPattern": "^\\s*(?:\\||in\\b|else\\b)\\b",
    "indentNextLinePattern": "^\\s*(?:.*\\bcase\\b.*\\bof\\s*$|.*\\bthen\\s*$|.*\\belse\\s*$|.*(?:=|=>)\\s*$)"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*.*\\bcase\\b.*\\bof\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*\\|.*=>\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*.*(?:=|=>)\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*.*\\b(?:then|else)\\s*$",
      "action": {
        "indent": "indent"
      }
    }
  ]
}