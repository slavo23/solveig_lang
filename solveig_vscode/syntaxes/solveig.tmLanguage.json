{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Solveig",
  "scopeName": "source.solveig",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#numeric_literals"
    },
    {
      "include": "#special_constants"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#fixity_declaration"
    },
    {
      "include": "#data_declaration"
    },
    {
      "include": "#class_declaration"
    },
    {
      "include": "#instance_declaration"
    },
    {
      "include": "#type_signature_declaration"
    },
    {
      "include": "#function_equation"
    },
    {
      "include": "#term_expression"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "\\{-",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.solveig"
            }
          },
          "end": "-\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.solveig"
            }
          },
          "name": "comment.block.solveig",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        },
        {
          "begin": "(^[ \\t]+)?(?=--)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.solveig"
            }
          },
          "end": "\\n",
          "name": "comment.line.double-dash.solveig",
          "patterns": [
            {
              "match": "--.*$",
              "name": "comment.line.double-dash.solveig"
            }
          ]
        },
        {
          "match": "(?<!@|#)-\\}",
          "name": "invalid.illegal.stray-comment-end.solveig"
        }
      ]
    },
    "strings": {
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.solveig"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.solveig"
        }
      },
      "name": "string.quoted.double.solveig",
      "patterns": [
        {
          "match": "\\\\(?:[nt\\\\'\"]|u\\{[0-9A-Fa-f]{1,6}\\})",
          "name": "constant.character.escape.solveig"
        }
      ]
    },
    "chars": {
      "begin": "'",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.character.begin.solveig"
        }
      },
      "end": "'",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.character.end.solveig"
        }
      },
      "name": "constant.character.solveig",
      "patterns": [
        {
          "match": "\\\\(?:[nt\\\\'\"]|u\\{[0-9A-Fa-f]{1,6}\\})",
          "name": "constant.character.escape.solveig"
        }
      ]
    },
    "numeric_literals": {
      "patterns": [
        {
          "match": "\\b[0-9]+(?:(?:\\.[0-9]+)(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)\\b",
          "name": "constant.numeric.float.solveig"
        },
        {
          "match": "\\b[0-9]+\\b",
          "name": "constant.numeric.integer.solveig"
        }
      ]
    },
    "special_constants": {
      "patterns": [
        {
          "match": "(\\()\\s*(\\))",
          "name": "constant.language.unit.solveig",
          "captures": {
            "1": {
              "name": "punctuation.paren.begin.solveig"
            },
            "2": {
              "name": "punctuation.paren.end.solveig"
            }
          }
        },
        {
          "match": "(\\[)\\s*(\\])",
          "name": "constant.language.empty-list.solveig",
          "captures": {
            "1": {
              "name": "punctuation.bracket.begin.solveig"
            },
            "2": {
              "name": "punctuation.bracket.end.solveig"
            }
          }
        }
      ]
    },
    "imports": {
      "begin": "^(\\s*)(import)\\b",
      "beginCaptures": {
        "2": {
          "name": "keyword.control.import.solveig"
        }
      },
      "end": "$",
      "name": "meta.import.solveig",
      "patterns": [
        {
          "match": "\\b(as|qualified|hiding)\\b",
          "name": "keyword.control.import.solveig"
        },
        {
          "include": "#qualified_type_constructor"
        },
        {
          "include": "#qualified_constructor"
        },
        {
          "include": "#qualified_identifier"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "fixity_declaration": {
      "begin": "^(\\s*)(infixl|infixr|infix)\\b",
      "beginCaptures": {
        "2": {
          "name": "keyword.declaration.fixity.solveig"
        }
      },
      "end": "(?:;\\s*)?$",
      "name": "meta.declaration.fixity.solveig",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#numeric_literals"
        },
        {
          "include": "#backticked_identifier"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#qualified_identifier"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "data_declaration": {
      "match": "^(\\s*)(data)\\s+([A-Z][A-Za-z0-9_']*)",
      "captures": {
        "2": {
          "name": "keyword.declaration.data.solveig"
        },
        "3": {
          "name": "entity.name.type.declaration.solveig"
        }
      }
    },
    "class_declaration": {
      "begin": "^(\\s*)(class)\\b",
      "beginCaptures": {
        "2": {
          "name": "keyword.declaration.class.solveig"
        }
      },
      "end": "$",
      "name": "meta.declaration.class.solveig",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "\\b(where)\\b",
          "name": "keyword.control.local.solveig"
        },
        {
          "match": "\\b([A-Z][A-Za-z0-9_']*)\\b(?=[^=\\n]*=>)",
          "name": "entity.other.inherited-class.solveig"
        },
        {
          "match": "(?:^|=>)\\s*([A-Z][A-Za-z0-9_']*)\\b",
          "captures": {
            "1": {
              "name": "entity.name.typeclass.solveig"
            }
          }
        },
        {
          "match": "\\b[a-z_][A-Za-z0-9_']*\\b",
          "name": "variable.parameter.type.solveig"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "instance_declaration": {
      "begin": "^(\\s*)(instance)\\b",
      "beginCaptures": {
        "2": {
          "name": "keyword.declaration.instance.solveig"
        }
      },
      "end": "$",
      "name": "meta.declaration.instance.solveig",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "\\b(where)\\b",
          "name": "keyword.control.local.solveig"
        },
        {
          "match": "\\b([A-Z][A-Za-z0-9_']*)\\b(?=[^=\\n]*=>)",
          "name": "entity.other.inherited-class.solveig"
        },
        {
          "match": "(?:^|=>|\\()\\s*([A-Z][A-Za-z0-9_']*)\\b",
          "captures": {
            "1": {
              "name": "entity.name.typeclass.solveig"
            }
          }
        },
        {
          "include": "#type_expression"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "type_signature_declaration": {
      "begin": "^(\\s*)([a-z_][A-Za-z0-9_']*)(\\s*:\\s*)",
      "beginCaptures": {
        "2": {
          "name": "entity.name.function.solveig"
        },
        "3": {
          "name": "keyword.operator.type.solveig"
        }
      },
      "end": "(?:;\\s*)?$",
      "name": "meta.declaration.value.solveig",
      "patterns": [
        {
          "include": "#type_expression"
        }
      ]
    },
    "type_expression": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#forall"
        },
        {
          "match": "=>",
          "name": "keyword.operator.big-arrow.solveig"
        },
        {
          "match": "->",
          "name": "keyword.operator.arrow.solveig"
        },
        {
          "include": "#qualified_type_constructor"
        },
        {
          "match": "\\b[a-z_][A-Za-z0-9_']*\\b",
          "name": "variable.parameter.type.solveig"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "forall": {
      "begin": "\\b(forall)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.forall.solveig"
        }
      },
      "end": "(\\.)|(->)",
      "endCaptures": {
        "1": {
          "name": "keyword.operator.period.solveig"
        },
        "2": {
          "name": "keyword.operator.arrow.solveig"
        }
      },
      "name": "meta.forall.solveig",
      "patterns": [
        {
          "match": "\\b[a-z_][A-Za-z0-9_']*\\b",
          "name": "variable.parameter.type.solveig"
        },
        {
          "include": "#comments"
        }
      ]
    },
    "function_equation": {
      "begin": "^(\\s*)(?!let\\b)([a-z_][A-Za-z0-9_']*)\\b(?=[^\\n]*(?<![=!<>])=(?![=>]))",
      "beginCaptures": {
        "2": {
          "name": "entity.name.function.solveig"
        }
      },
      "end": "(?:;\\s*)?$",
      "name": "meta.declaration.value.solveig",
      "patterns": [
        {
          "match": "\\b(fun)\\b",
          "name": "keyword.control.lambda.solveig"
        },
        {
          "match": "\\b(case|of|if|then|else|do)\\b",
          "name": "keyword.control.conditional.solveig"
        },
        {
          "match": "\\b(let|in|where)\\b",
          "name": "keyword.control.local.solveig"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#chars"
        },
        {
          "include": "#numeric_literals"
        },
        {
          "include": "#special_constants"
        },
        {
          "include": "#holes"
        },
        {
          "include": "#backticked_identifier"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#qualified_constructor"
        },
        {
          "include": "#qualified_identifier"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "term_expression": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#chars"
        },
        {
          "include": "#numeric_literals"
        },
        {
          "include": "#special_constants"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#holes"
        },
        {
          "include": "#backticked_identifier"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#qualified_constructor"
        },
        {
          "include": "#qualified_identifier"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(case|of|if|then|else|do)\\b",
          "name": "keyword.control.conditional.solveig"
        },
        {
          "match": "\\b(let|in|where)\\b",
          "name": "keyword.control.local.solveig"
        },
        {
          "match": "\\b(fun)\\b",
          "name": "keyword.control.lambda.solveig"
        },
        {
          "match": "\\b(data|type|sig|class|instance|infixl|infixr|infix|default|export|private|reexport)\\b",
          "name": "keyword.declaration.solveig"
        },
        {
          "match": "\\b(import|as|qualified|hiding)\\b",
          "name": "keyword.control.import.solveig"
        },
        {
          "match": "\\b(True|False)\\b",
          "name": "constant.language.boolean.solveig"
        }
      ]
    },
    "holes": {
      "match": "\\?\\?|\\?[a-z_][A-Za-z0-9_']*|\\?\\b",
      "name": "markup.underline.hole.solveig"
    },
    "backticked_identifier": {
      "match": "(`)((?:[a-z_][A-Za-z0-9_']*\\.)*[a-z_][A-Za-z0-9_']*)(`)",
      "captures": {
        "1": {
          "name": "punctuation.definition.operator.begin.solveig"
        },
        "2": {
          "name": "variable.function.infix.solveig"
        },
        "3": {
          "name": "punctuation.definition.operator.end.solveig"
        }
      }
    },
    "operators": {
      "patterns": [
        {
          "match": "=>",
          "name": "keyword.operator.fat-arrow.solveig"
        },
        {
          "match": "->",
          "name": "keyword.operator.arrow.solveig"
        },
        {
          "match": "<-",
          "name": "keyword.operator.bind-arrow.solveig"
        },
        {
          "match": "::",
          "name": "keyword.operator.cons.solveig"
        },
        {
          "match": ":",
          "name": "keyword.operator.type.solveig"
        },
        {
          "match": "==|>=|<=|>|<",
          "name": "keyword.operator.comparison.solveig"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.solveig"
        },
        {
          "match": "[+\\-*/%]",
          "name": "keyword.operator.arithmetic.solveig"
        },
        {
          "match": "\\|",
          "name": "keyword.operator.pipe.solveig"
        },
        {
          "match": "\\.",
          "name": "keyword.operator.period.solveig"
        },
        {
          "match": "[!#$%&*+./<=>?@\\\\^|\\-~:]+",
          "name": "keyword.operator.symbolic.solveig"
        }
      ]
    },
    "qualified_type_constructor": {
      "match": "(?x)(?<![A-Za-z0-9_'])(')?((?:[a-z_][A-Za-z0-9_']*\\.)*)([A-Z][A-Za-z0-9_']*)\\b",
      "captures": {
        "1": {
          "name": "keyword.operator.promotion.solveig"
        },
        "2": {
          "name": "entity.name.namespace.solveig"
        },
        "3": {
          "name": "storage.type.solveig"
        }
      }
    },
    "qualified_constructor": {
      "match": "(?x)(?<![A-Za-z0-9_'])((?:[a-z_][A-Za-z0-9_']*\\.)*)([A-Z][A-Za-z0-9_']*)\\b",
      "captures": {
        "1": {
          "name": "entity.name.namespace.solveig"
        },
        "2": {
          "name": "constant.other.constructor.solveig"
        }
      }
    },
    "qualified_identifier": {
      "match": "(?x)(?<![A-Za-z0-9_'])((?:[a-z_][A-Za-z0-9_']*\\.)*)([a-z_][A-Za-z0-9_']*)\\b",
      "captures": {
        "1": {
          "name": "entity.name.namespace.solveig"
        },
        "2": {
          "name": "variable.other.solveig"
        }
      }
    },
    "punctuation": {
      "patterns": [
        {
          "match": "(\\()|(\\))",
          "captures": {
            "1": {
              "name": "punctuation.paren.begin.solveig"
            },
            "2": {
              "name": "punctuation.paren.end.solveig"
            }
          }
        },
        {
          "match": "(\\[)|(\\])",
          "captures": {
            "1": {
              "name": "punctuation.bracket.begin.solveig"
            },
            "2": {
              "name": "punctuation.bracket.end.solveig"
            }
          }
        },
        {
          "match": "(\\{)|(\\})",
          "captures": {
            "1": {
              "name": "punctuation.brace.begin.solveig"
            },
            "2": {
              "name": "punctuation.brace.end.solveig"
            }
          }
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.solveig"
        },
        {
          "match": ";",
          "name": "punctuation.separator.semicolon.solveig"
        }
      ]
    }
  }
}
